<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens taken from "HD Camera App.dc.html" (claude.ai/design).

    These are the light-theme values; values-night holds the design's own dark ones. The
    viewfinder, editor and intro always resolve the night set (see ui/Theme.kt), so only
    the surfaces, lines, accent and text flip here — the white washes and scrims drawn over
    a picture are the same in both.
-->
<resources>
    <!-- Surfaces -->
    <color name="dc_bg">#F3F3F7</color>
    <color name="dc_surface">#FFFFFF</color>
    <color name="dc_surface_2">#E9E9F0</color>
    <color name="dc_surface_3">#D6D6E0</color>
    <color name="dc_slot">#E2E2EA</color>

    <!-- Lines -->
    <color name="dc_border">#E0E0E8</color>
    <color name="dc_border_2">#E8E8EF</color>
    <color name="dc_border_3">#C8C8D4</color>
    <color name="dc_divider">#E4E4EC</color>

    <!-- Accent -->
    <color name="dc_accent">#7152E8</color>
    <color name="dc_on_accent">#FFFFFF</color>
    <color name="dc_accent_container">#ECE6FF</color>
    <color name="dc_accent_container_2">#F4F0FF</color>
    <color name="dc_accent_glow">#2E7152E8</color>
    <color name="dc_accent_fill">#597152E8</color>

    <!-- Text -->
    <color name="dc_text">#16161D</color>
    <color name="dc_text_muted">#565665</color>
    <color name="dc_text_dim">#62626F</color>
    <color name="dc_text_dim_2">#70707E</color>
    <color name="dc_text_faint">#8A8A98</color>
    <color name="dc_text_80">#99FFFFFF</color>
    <color name="dc_text_70">#B3FFFFFF</color>

    <!-- Status -->
    <color name="dc_record">#EB4444</color>
    <color name="dc_record_92">#EBEB4444</color>
    <color name="dc_amber">#FFD166</color>

    <!-- Viewfinder scrims (rgba(14,14,20,x) in the design) -->
    <color name="dc_scrim_50">#800E0E14</color>
    <color name="dc_scrim_55">#8C0E0E14</color>
    <color name="dc_scrim_62">#9E0E0E14</color>

    <!-- White washes -->
    <color name="dc_white_14">#24FFFFFF</color>
    <color name="dc_white_20">#33FFFFFF</color>
    <color name="dc_white_22">#38FFFFFF</color>
    <color name="dc_white_25">#40FFFFFF</color>
    <color name="dc_white_45">#73FFFFFF</color>
    <color name="dc_white_85">#D9FFFFFF</color>
    <color name="dc_white_90">#E6FFFFFF</color>

    <!-- Drop shadow behind text drawn over the viewfinder. -->
    <color name="dc_shadow">#CC000000</color>

    <!-- Home dashboard: brand gradients that read the same on either theme. -->
    <color name="home_hero_start">#8A2BE2</color>
    <color name="home_hero_end">#D07BEA</color>
    <color name="home_collage_start">#FFA43A</color>
    <color name="home_collage_end">#F0504E</color>
    <color name="home_edit_start">#3FD0E0</color>
    <color name="home_edit_end">#2F66E8</color>
    <color name="home_gallery_start">#5A2A85</color>
    <color name="home_gallery_end">#9A63C4</color>
    <color name="home_nav_active">#FF6B9E</color>
