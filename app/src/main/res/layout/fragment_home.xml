<?xml version="1.0" encoding="utf-8"?>
<!--
    Home · the dashboard the app opens on once onboarding is behind the user.

    Header, a scrolling column of cards, and a bottom bar whose middle rises into the camera
    button. The header and bar stay put and only the cards scroll, so a large font size or a
    short screen pushes the cards rather than clipping them. Nothing here touches CameraX:
    this screen only decides where to go, and the camera permission is asked for at the
    moment a camera is actually opened.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dc_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dc_surface"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/touch_target"
            android:layout_marginEnd="@dimen/touch_target"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.HD.TitleLarge" />
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/dc_text" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/screen_h_padding"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="@dimen/screen_h_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Take Photo: the one thing this app is for. White on the gradient in both themes. -->
            <LinearLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="12dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:text="@string/home_take_photo"
                        android:textColor="@color/white"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/home_take_photo_body"
                        android:textColor="@color/dc_white_90"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btnOpenCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/pill_button_height"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_pill_white"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:gravity="center"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:text="@string/open_camera"
                        android:textColor="@color/home_hero_start"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Decorative: the heading beside it already says what this is. -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_hero_art" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardCollage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:layout_width="@dimen/home_tool_icon"
                        android:layout_height="@dimen/home_tool_icon"
                        android:background="@drawable/bg_home_icon_collage"
                        android:importantForAccessibility="no"
                        android:padding="17dp"
                        android:src="@drawable/ic_collage"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/home_collage_maker"
                        android:textAppearance="@style/TextAppearance.HD.ListTitle"
                        android:textSize="18sp" />

                    <!-- Collage has no screen behind it yet, and says so. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/coming_soon"
                        android:textAppearance="@style/TextAppearance.HD.ListSub" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/home_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp">

                    <ImageView
                        android:layout_width="@dimen/home_tool_icon"
                        android:layout_height="@dimen/home_tool_icon"
                        android:background="@drawable/bg_home_icon_edit"
                        android:importantForAccessibility="no"
                        android:padding="18dp"
                        android:src="@drawable/ic_markup"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/action_edit_photo"
                        android:textAppearance="@style/TextAppearance.HD.ListTitle"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gallery gets a card of its own: it is where the work ends up. -->
            <LinearLayout
                android:id="@+id/cardGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_gap"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/my_gallery"
                        android:textAppearance="@style/TextAppearance.HD.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/home_gallery_body"
                        android:textAppearance="@style/TextAppearance.HD.ListSub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_home_gallery_tile"
                    android:importantForAccessibility="no"
                    android:padding="26dp"
                    android:src="@drawable/ic_gallery"
                    app:tint="@color/dc_white_85" />
            </LinearLayout>

            <!-- Why a camera screen could not open, and the way to put it right. -->
            <TextView
                android:id="@+id/tvPermissionNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_gap"
                android:background="@drawable/bg_home_card"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:textAppearance="@style/TextAppearance.HD.ListSub"
                android:visibility="gone"
                tools:text="Camera access is needed to shoot. Open settings"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>

    <!-- Home · camera · My Creative. The bar's hump is drawn, not laid out. -->
    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.example.hd_camera.ui.widget.CurvedNavBarView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingTop="26dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/touch_target"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_nav_active"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/home_nav_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/ibm_plex_sans_medium"
                    android:text="@string/nav_home"
                    android:textColor="@color/home_nav_active"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="120dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/navMyCreative"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:minHeight="@dimen/touch_target"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_my_creative"
                    app:tint="@color/dc_text_dim" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/ibm_plex_sans_medium"
                    android:text="@string/nav_my_creative"
                    android:textColor="@color/dc_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnNavCamera"
            android:layout_width="@dimen/home_nav_fab"
            android:layout_height="@dimen/home_nav_fab"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_home_fab"
            android:contentDescription="@string/cd_camera"
            android:elevation="4dp"
            android:padding="18dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>
