<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of a chooser, shared by the anchored popup and the bottom sheet so a setting
    reads the same wherever it is offered.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/optionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOptionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.HD.ListTitle"
            tools:text="4K · 60fps" />

        <TextView
            android:id="@+id/tvOptionDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.HD.ListSub"
            android:visibility="gone"
            tools:text="This camera cannot record at that size"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivOptionCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/cd_option_selected"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/dc_accent"
        tools:visibility="visible" />
</LinearLayout>
