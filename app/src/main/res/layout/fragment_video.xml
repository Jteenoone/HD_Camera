<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 08 · Video -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dc_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dc_bg"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <TextView
        android:id="@+id/tvCameraStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAppearance="@style/TextAppearance.HD.Caption"
        android:textColor="@color/dc_text_dim_2"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Recording" />

    <!--
        The zoom wheel. An overlay here too, and for the same reason: this screen has no
        black panel to put it in, and growing one would be the very thing Video avoids.
        The fragment pushes it clear of the controls once they have been measured.
    -->
    <com.digitalcamerahd.camera4k.selfiecamera.ui.widget.ZoomArcView
        android:id="@+id/zoomArc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zoom_arc_height"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_top_60"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnClose"
                style="@style/Widget.HD.ViewfinderIcon"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close" />

            <LinearLayout
                android:id="@+id/recBadge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_record"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/recIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_shutter_inner_white" />

                <TextView
                    android:id="@+id/tvRecTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.06"
                    android:text="@string/rec_time"
                    android:textAppearance="@style/TextAppearance.HD.Mono.Chip" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_vf_chip_12"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:id="@+id/btnQuality"
                android:text="@string/video_4k60"
                android:textAppearance="@style/TextAppearance.HD.Mono.Chip"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vf_chip_12"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:id="@+id/btnEis"
                android:text="@string/eis"
                android:textAppearance="@style/TextAppearance.HD.Mono.Chip"
                android:textColor="@color/dc_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Audio meter sits at the bottom of the frame area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/micIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cd_mic_level"
                android:src="@drawable/ic_mic"
                app:tint="@color/dc_text_80" />

            <LinearLayout
                android:id="@+id/audioMeter"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_bottom_82"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="22dp">

            <!-- The ratio a pinch is landing on; gone again once the fingers leave. -->
            <TextView
                android:id="@+id/tvZoomRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_vf_chip_9"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textAppearance="@style/TextAppearance.HD.Mono.Chip"
                android:visibility="gone"
                tools:text="2.4×"
                tools:visibility="visible" />

            <com.digitalcamerahd.camera4k.selfiecamera.ui.widget.ZoomChipRow
                android:id="@+id/zoomChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/modeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <!--
                    Idle: the last shot, which opens the Gallery. Recording: the same slot
                    becomes Pause / Resume, so the thumb never has to travel.
                -->
                <FrameLayout
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button">

                    <ImageView
                        android:id="@+id/btnLastShot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_thumb_border"
                        android:contentDescription="@string/cd_last_shot"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/btnPauseResume"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_round_scrim_62"
                        android:contentDescription="@string/cd_pause"
                        android:padding="14dp"
                        android:src="@drawable/ic_pause"
                        android:visibility="gone"
                        app:tint="@color/dc_text"
                        tools:visibility="visible" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btnRecord"
                    android:layout_width="@dimen/shutter_size"
                    android:layout_height="@dimen/shutter_size"
                    android:background="@drawable/bg_shutter_ring_video"
                    android:contentDescription="@string/cd_record">

                    <View
                        android:id="@+id/recordInner"
                        android:layout_width="@dimen/record_inner_idle"
                        android:layout_height="@dimen/record_inner_idle"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_record_circle" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Idle: flip the camera. Recording: take a still without stopping. -->
                <FrameLayout
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button">

                    <ImageView
                        android:id="@+id/btnFlip"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_round_scrim_62"
                        android:contentDescription="@string/cd_switch_camera"
                        android:padding="14dp"
                        android:src="@drawable/ic_flip_camera"
                        app:tint="@color/dc_text" />

                    <ImageView
                        android:id="@+id/btnSnapshot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_round_scrim_62"
                        android:contentDescription="@string/cd_snapshot"
                        android:padding="13dp"
                        android:src="@drawable/ic_camera"
                        android:visibility="gone"
                        app:tint="@color/dc_text"
                        tools:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
