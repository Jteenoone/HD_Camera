<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 08 · Video -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dc_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dc_bg"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <TextView
        android:id="@+id/tvCameraStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAppearance="@style/TextAppearance.HD.Caption"
        android:textColor="@color/dc_text_dim_2"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Recording" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_top_60"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/recBadge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_record"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/recIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_shutter_inner_white" />

                <TextView
                    android:id="@+id/tvRecTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.06"
                    android:text="@string/rec_time"
                    android:textAppearance="@style/TextAppearance.HD.Mono.Chip" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_vf_chip_12"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:id="@+id/btnQuality"
                android:text="@string/video_4k60"
                android:textAppearance="@style/TextAppearance.HD.Mono.Chip"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vf_chip_12"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:id="@+id/btnEis"
                android:text="@string/eis"
                android:textAppearance="@style/TextAppearance.HD.Mono.Chip"
                android:textColor="@color/dc_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Audio meter sits at the bottom of the frame area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cd_mic_level"
                android:src="@drawable/ic_mic"
                app:tint="@color/dc_text_80" />

            <LinearLayout
                android:id="@+id/audioMeter"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_on" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_audio_bar_off" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_bottom_82"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="22dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/modeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <ImageView
                    android:id="@+id/btnSnapshot"
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button"
                    android:background="@drawable/bg_round_scrim_62"
                    android:contentDescription="@string/cd_preview"
                    android:padding="15dp"
                    android:src="@drawable/ic_frame_square"
                    app:tint="@color/dc_text" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btnRecord"
                    android:layout_width="@dimen/shutter_size"
                    android:layout_height="@dimen/shutter_size"
                    android:background="@drawable/bg_shutter_ring_video"
                    android:contentDescription="@string/cd_record">

                    <View
                        android:id="@+id/recordInner"
                        android:layout_width="@dimen/record_inner_idle"
                        android:layout_height="@dimen/record_inner_idle"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_record_circle" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnFlip"
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button"
                    android:background="@drawable/bg_round_scrim_62"
                    android:contentDescription="@string/cd_switch_camera"
                    android:padding="14dp"
                    android:src="@drawable/ic_flip_camera"
                    app:tint="@color/dc_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
