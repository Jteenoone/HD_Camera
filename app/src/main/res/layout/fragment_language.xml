<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 03b · Language, between the intro and the permission hand-off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/languageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dc_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/screen_h_padding"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_surface_icon"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/dc_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/language"
            android:textAppearance="@style/TextAppearance.HD.Title" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLanguageBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="14dp"
        android:text="@string/language_body"
        android:textAppearance="@style/TextAppearance.HD.Body" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/languageList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/languageFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/btnContinue"
            style="@style/Widget.HD.PrimaryButton"
            android:text="@string/continue_action"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>
</LinearLayout>
