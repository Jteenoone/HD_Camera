<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 07 · Live filters -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dc_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dc_bg"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <TextView
        android:id="@+id/tvCameraStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAppearance="@style/TextAppearance.HD.Caption"
        android:textColor="@color/dc_text_dim_2"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Filtered preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_top_60"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/Widget.HD.ViewfinderIcon"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/live_filters"
                android:textColor="@color/dc_text"
                android:textSize="16sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCompare"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_scrim"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/compare"
                android:textColor="@color/dc_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_bottom_82"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="22dp">

            <!-- Filter strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/strength"
                        android:textAppearance="@style/TextAppearance.HD.Mono.Label" />

                    <TextView
                        android:id="@+id/tvStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strength_value"
                        android:textAppearance="@style/TextAppearance.HD.Mono.Label"
                        android:textColor="@color/dc_accent" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="1"
                    android:value="72"
                    android:valueFrom="0"
                    android:valueTo="100" />
            </LinearLayout>

            <!-- Filter swatches -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Shutter row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <ImageView
                    android:id="@+id/btnLastShot"
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button"
                    android:background="@drawable/bg_thumb_border"
                    android:contentDescription="@string/cd_last_shot"
                    android:scaleType="centerCrop" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btnShutter"
                    android:layout_width="@dimen/shutter_size"
                    android:layout_height="@dimen/shutter_size"
                    android:background="@drawable/bg_shutter_ring_white"
                    android:contentDescription="@string/cd_shutter"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_shutter_inner_white" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnFlip"
                    android:layout_width="@dimen/vf_side_button"
                    android:layout_height="@dimen/vf_side_button"
                    android:background="@drawable/bg_round_scrim_62"
                    android:contentDescription="@string/cd_switch_camera"
                    android:padding="14dp"
                    android:src="@drawable/ic_flip_camera"
                    app:tint="@color/dc_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
