<?xml version="1.0" encoding="utf-8"?>
<!--
    One quick action on the Home dashboard. Included four times rather than repeated, so a
    change to the shape lands on all of them at once.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/actionIcon"
        android:layout_width="@dimen/home_icon_tile"
        android:layout_height="@dimen/home_icon_tile"
        android:background="@drawable/bg_home_icon"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_camera"
        app:tint="@color/dc_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/actionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.HD.ListTitle"
            tools:text="Pro Camera" />

        <!-- Only shown for an action that is not ready yet. -->
        <TextView
            android:id="@+id/actionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.HD.ListSub"
            android:visibility="gone"
            tools:text="Coming soon"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
